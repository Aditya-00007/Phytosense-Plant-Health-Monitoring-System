# Optional: OpenWeatherMap API key for /weather and /alerts endpoints
OPENWEATHER_API_KEY=

# Optional: enables Groq LLM enrichment for treatment/irrigation advice
GROQ_API_KEY=

# Optional: path to a trained .onnx plant disease classification model
MODEL_PATH=

# Comma-separated allowed CORS origins (* for local Expo web/mobile testing)
CORS_ORIGINS=*
